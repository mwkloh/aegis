# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.secret*

# --- AEGIS local state (lives in ~/.aegis/, but block stray copies) ---
.aegis/
workspace/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual envs ---
.venv/
venv/
env/
ENV/
.python-version.local

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# --- IDE / OS ---
.vscode/
.idea/
.claude/
*.swp
*.swo
.DS_Store
._*
Thumbs.db

# --- Databases / vector indexes (always local) ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.lance/

# --- Generated artifacts ---
coding_harness/diffs/*.patch
coding_harness/diffs/*.diff
eval/results/
runtime/harness/openharness/   # vendored as submodule later — not tracked here

# --- Logs ---
*.log
logs/

# --- Git worktrees ---
.worktrees/

# --- Article drafts (repo root only) ---
# Long-form write-ups drafted in-repo and published elsewhere. Root-anchored
# and dated so it cannot match anything nested or any real project doc —
# CONTEXT.md, AEGIS_BLUEPRINT.md and docs/ stay tracked. Covers future drafts
# too, which is the point: the moment one gets committed by accident is the
# moment nobody remembered to add it here.
#   2026-05-04-aegis-design-philosophy.md
#   2026-05-04-aegis-header.png
#   2026-05-04-aegis-medium-article.md
#   2026-08-20-aegis-medium-article-benchmark-results.md
/20??-??-??-aegis-*
