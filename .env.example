# AEGIS environment template.
# Real values live in ~/.aegis/.env (NEVER commit).
# This file lists every key the runtime expects so newcomers can see the surface.

# --- AEGIS identity ---
AEGIS_HOME=~/.aegis/workspace
AEGIS_API_KEY=

# --- LLM providers ---
# Ollama is local; no key required, just confirm the base URL.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenRouter (Tier 1 frontier model)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: other providers (carried over from atamai for future skills)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Embeddings ---
# bge-m3 is served by Ollama; no key. EMBEDDING_API_KEY only used if a remote
# embedding provider is wired in later.
EMBEDDING_API_KEY=

# --- Telegram (Phase: after walking skeleton) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=                 # comma-separated allowlist of user_ids
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOW_FROM=
TELEGRAM_REQUIRE_MENTION=false
TELEGRAM_ACK_EMOJI=

# --- Models (Tier 0 / Tier 1 / Reflection) ---
MODEL_FAST=gemma4:e2b             # Tier 0 — intent classification
MODEL_SMART=minimax/minimax-m2.7  # Tier 1 — skill reasoning (OpenRouter route)
MODEL_SMART_LOCAL=llama3.1:8b     # Tier 1 — skill reasoning (Ollama route: local weights or a -cloud tag)
MODEL_SMART_PROVIDER=ollama       # ollama | openrouter — explicit SMART-tier pin, no silent fallback
# MODEL_SMART_THINK=              # unset | true | false — Ollama reasoning channel for Tier-1.
                                  # Unset leaves each model's own default. No safe global value:
                                  # measured 2026-08-25, false took qwen3-vl:4b from 40%→80% TGC
                                  # but dropped qwen3.5:4b-mlx in-budget 73.3%→6.7%. Ignored by
                                  # OpenRouter. See docs/superpowers/plans/2026-08-24-eval-measurement-confounds.md
MODEL_REFLECTION=gemma4:e4b       # Reflection plane (offline / heartbeat)
DEFAULT_MODEL=gemma4:e2b

# Brave Search API key — required for /board --research
# Get a free key at https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=
