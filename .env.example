# AEGIS environment template.
# Real values live in ~/.aegis/.env (NEVER commit).
# This file lists every key the runtime expects so newcomers can see the surface.

# --- AEGIS identity ---
# Where state lives. Defaults to ~/.aegis (set AEGIS_ROOT to move it); the workspace is
# <AEGIS_ROOT>/workspace. Leave AEGIS_HOME unset unless the workspace must live elsewhere:
# a value here overrides AEGIS_ROOT for the workspace.
# AEGIS_HOME=~/.aegis/workspace
AEGIS_API_KEY=

# --- LLM providers ---
# Ollama is local; no key required, just confirm the base URL.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenRouter (Tier 1 frontier model)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: other providers (carried over from atamai for future skills)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Embeddings ---
# bge-m3 is served by Ollama; no key. EMBEDDING_API_KEY only used if a remote
# embedding provider is wired in later.
EMBEDDING_API_KEY=

# --- Telegram (Phase: after walking skeleton) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to talk to the bot. Leave it
# commented to use config.json's telegram.userAllowlist instead: a blank value here
# overrides that list with an empty one, and an empty allowlist refuses everyone.
# TELEGRAM_USER_ALLOWLIST=123456789
TELEGRAM_CHAT_ID=
TELEGRAM_REQUIRE_MENTION=false
TELEGRAM_ACK_EMOJI=

# --- Models (Tier 0 / Tier 1 / Reflection) ---
MODEL_FAST=gemma4:e2b             # Tier 0 — intent classification
MODEL_SMART=minimax/minimax-m2.7  # Tier 1 — skill reasoning (OpenRouter route)
# Replace YOUR_MODEL with the Tier-1 reasoning model, then `ollama pull` it. The
# benchmark measured gemma4:e4b-mlx, qwen3.5:4b-mlx, lfm2.5:8b and llama3.2:3b, and the
# starter config.json carries a profile for each. Any other model runs the planner
# (see README: "Using your own local model"). MODEL_FAST / MODEL_REFLECTION work the same way.
MODEL_SMART_LOCAL=YOUR_MODEL      # Tier 1 — skill reasoning (Ollama route: local weights or a -cloud tag)
MODEL_SMART_PROVIDER=ollama       # ollama | openrouter — explicit SMART-tier pin, no silent fallback
# MODEL_SMART_THINK=              # unset | true | false — Ollama reasoning channel for Tier-1.
                                  # GLOBAL override; beats any per-model profile, so it stays the
                                  # escape hatch for a debugging session. Prefer `modelProfiles`
                                  # in ~/.aegis/config.json for durable per-model settings:
                                  #
                                  #   "modelProfiles": {
                                  #     "qwen3-vl:4b":    { "think": false },
                                  #     "qwen3.5:4b-mlx": { "think": true }
                                  #   }
                                  #
                                  # Those two values are measured, not guessed (2026-08-25):
                                  # think=false took qwen3-vl:4b from 40%→80% TGC, and dropped
                                  # qwen3.5:4b-mlx's in-budget score 73.3%→6.7%. Keys match on
                                  # exact model id — no family prefixes, because those two share
                                  # a vendor and need opposite settings. Ignored by OpenRouter.
                                  # See docs/superpowers/plans/2026-08-24-eval-measurement-confounds.md
MODEL_REFLECTION=gemma4:e4b       # Reflection plane (offline / heartbeat)
DEFAULT_MODEL=gemma4:e2b

# Brave Search API key — required for /board --research
# Get a free key at https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=
